# BibTeX样式：plain

# --- MAN 配置 ---
GENERATE_MAN           = NO
# 是否生成MAN手册：NO（非命令行工具，无需MAN）
MAN_OUTPUT             = man
# MAN输出子目录
MAN_EXTENSION          = .3
# MAN文件后缀
MAN_SUBDIR             =
# MAN子目录：为空则不使用
MAN_LINKS              = NO
# 是否生成MAN链接：NO

# --- RTF 配置 ---
GENERATE_RTF           = NO
# 是否生成RTF文档：NO
RTF_OUTPUT             = rtf
# RTF输出子目录
COMPACT_RTF            = NO
# 是否压缩RTF：NO
RTF_HYPERLINKS         = NO
# 是否生成RTF超链接：NO
RTF_STYLESHEET_FILE    =
# RTF样式表文件：为空则不使用
RTF_EXTENSIONS_FILE    =
# RTF扩展文件：为空则不使用

# --- XML 配置 ---
GENERATE_XML           = NO
# 是否生成XML文档：NO
XML_OUTPUT             = xml
# XML输出子目录
XML_PROGRAMLISTING     = YES
# 是否包含程序列表：YES

# --- DOCBOOK 配置 ---
GENERATE_DOCBOOK       = NO
# 是否生成DocBook文档：NO
DOCBOOK_OUTPUT         = docbook
# DocBook输出子目录

# =============================================================================
# 8. 交互配置（Interworking with other tools）
# =============================================================================
ALLEXTERNALS           = NO
# 是否包含所有外部引用：NO
EXTERNAL_GROUPS        = YES
# 是否包含外部组：YES
EXTERNAL_PAGES         = YES
# 是否包含外部页面：YES

# =============================================================================
# 9. 警告/日志配置（Warnings and progress messages）
# =============================================================================
QUIET                  = NO
# 是否静默模式：NO（显示生成进度，便于排查问题）
WARNINGS               = YES
# 是否显示警告：YES
WARN_IF_UNDOCUMENTED   = YES
# 无文档注释时是否警告：YES（督促补全注释）
WARN_IF_DOC_ERROR      = YES
# 文档注释错误时是否警告：YES（如参数不匹配）
WARN_NO_PARAMDOC       = YES
# 参数无文档注释时是否警告：YES
WARN_AS_ERROR          = NO
# 是否将警告视为错误：NO（避免小警告中断生成）
WARN_FORMAT            = "$file:$line: $text"
# 警告格式：文件:行号: 警告信息
WARN_LOGFILE           = ./docs/doxygen_warnings.log
# 警告日志文件：保存警告信息便于后续修复

# =============================================================================
# 10. 进阶配置（Miscellaneous configuration options）
# =============================================================================
GENERATE_AUTOGEN_DEF   = NO
# 是否生成autogen.def文件：NO
GENERATE_PERLMOD       = NO
# 是否生成Perl模块：NO
PERLMOD_LATEX          = NO
# 是否生成Perl模块LaTeX文档：NO
PERLMOD_PRETTY         = YES
# Perl模块是否美化输出：YES
PERLMOD_MAKEVAR_PREFIX =
# Perl模块变量前缀：为空则不使用
NUM_PROC_THREADS       = 0
# 处理线程数：0为自动（根据CPU核心数）